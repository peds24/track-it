# Track It API Keys & Credentials
# When deploying to GitHub Pages via your private repository,
# add these four variables under:
# Repository Settings > Secrets and variables > Actions > New repository secret

EXPO_PUBLIC_TMDB_API_KEY=your_tmdb_api_key_here
EXPO_PUBLIC_METRON_USERNAME=your_metron_username_here
EXPO_PUBLIC_METRON_PASSWORD=your_metron_password_here
EXPO_PUBLIC_GOOGLE_BOOKS_API_KEY=your_google_books_api_key_here
