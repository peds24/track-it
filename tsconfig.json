{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "paths": { "@/*": ["./src/*"] },
    "types": ["jest", "node"]
  },
  // Expo's base excludes, plus apple/ (the native Iris app): Xcode checks out
  // GRDB's SQLite sources, JS included, under apple/DerivedData.
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js",
    "android",
    "ios",
    "apple",
    ".claude"
  ]
}
