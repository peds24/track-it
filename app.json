{
  "expo": {
    "name": "Track It",
    "slug": "track-it",
    "scheme": "trackit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.peds24.trackit",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#DCDFD0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.peds24.trackit"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png",
      "themeColor": "#386A20",
      "backgroundColor": "#FBFDF8"
    },
    "plugins": [
      "expo-sqlite",
      "expo-router",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Used to scan a barcode when adding a book, manga or comic."
        }
      ],
      "expo-font",
      "expo-asset"
    ],
    "owner": "peds24",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d319cc51-6ebe-43b0-b50b-f0e843d1903c"
      }
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d319cc51-6ebe-43b0-b50b-f0e843d1903c"
    }
  }
}
