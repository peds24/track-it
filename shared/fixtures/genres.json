{
  "module": "genres",
  "generatedBy": "npm run fixtures:record",
  "timezone": "UTC",
  "cases": [
    {
      "name": "splits path-style categories into separate genres",
      "fn": "genresFrom",
      "args": [
        [
          "Fiction / Fantasy / Epic"
        ]
      ],
      "expect": [
        "Fiction",
        "Fantasy",
        "Epic"
      ]
    },
    {
      "name": "drops filler and case-insensitive duplicates, keeping first spelling",
      "fn": "genresFrom",
      "args": [
        [
          "Fiction / General",
          "fiction",
          "Horror",
          null,
          ""
        ]
      ],
      "expect": [
        "Fiction",
        "Horror"
      ]
    },
    {
      "name": "nothing in, nothing out",
      "fn": "genresFrom",
      "args": [
        null
      ],
      "expect": []
    },
    {
      "name": "nothing in, nothing out (2)",
      "fn": "genresFrom",
      "args": [
        []
      ],
      "expect": []
    },
    {
      "name": "withGenres adds the key only when there is something to add",
      "fn": "withGenres",
      "args": [
        {
          "a": 1
        },
        [
          "Drama"
        ]
      ],
      "expect": {
        "a": 1,
        "genres": [
          "Drama"
        ]
      }
    },
    {
      "name": "withGenres adds the key only when there is something to add (2)",
      "fn": "withGenres",
      "args": [
        {
          "a": 1
        },
        [
          "General"
        ]
      ],
      "expect": {
        "a": 1
      }
    }
  ]
}
