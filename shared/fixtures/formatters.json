  "cases": [
    {
      "name": "cleanDescription strips tags, turning paragraph and line breaks into newlines",
      "fn": "cleanDescription",
      "args": [
        "<p>First <b>bold</b> line.</p><p>Second<br>third</p>"
      ],
      "expect": "First bold line.\n\nSecond\nthird"
    },
    {
      "name": "cleanDescription decodes named and numeric entities",
      "fn": "cleanDescription",
      "args": [
        "Tom &amp; Jerry &quot;hi&quot; &#39;yo&#39; &#x2014; ok&hellip;"
      ],
      "expect": "Tom & Jerry \"hi\" 'yo' — ok…"
    },
    {
      "name": "cleanDescription collapses runs of whitespace and blank lines",
      "fn": "cleanDescription",
      "args": [
        "  a   b \n\n\n\n c  "
      ],
      "expect": "a b\n\nc"
    },
    {
      "name": "cleanDescription returns null for empty, missing, or markup-only input",
      "fn": "cleanDescription",
      "args": [
        null
      ],
      "expect": null
    },
    {
      "name": "cleanDescription returns null for empty, missing, or markup-only input (2)",
      "fn": "cleanDescription",
      "args": [
        "   "
      ],
      "expect": null
    },
    {
      "name": "cleanDescription returns null for empty, missing, or markup-only input (3)",
      "fn": "cleanDescription",
      "args": [
        "<p> </p>"
      ],
      "expect": null
    },
    {
      "name": "decodeEntities leaves an unknown entity as written rather than dropping it",
      "fn": "decodeEntities",
      "args": [
        "a &madeup; b"
      ],
      "expect": "a &madeup; b"
    },
    {
      "name": "cleanDescription: encoded brackets like &lt;PG-13&gt; decode",
      "fn": "cleanDescription",
      "args": [
