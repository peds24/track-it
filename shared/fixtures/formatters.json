      ],
      "expect": "Rating: <PG-13> content, also x < y and y > z ok."
    },
    {
      "name": "cleanDescription is idempotent: a decoded pass-1 result is unchanged",
      "fn": "cleanDescription",
      "args": [
        "Rating: <PG-13> content, also x < y and y > z ok."
      ],
      "expect": "Rating: <PG-13> content, also x < y and y > z ok."
    },
    {
